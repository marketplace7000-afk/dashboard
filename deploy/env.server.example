# ──────────────────────────────────────────────────────────────────────────
# Auto Vibe — серверный .env для self-hosted деплоя (Timeweb / Linux VM)
# ──────────────────────────────────────────────────────────────────────────
# Скопируй в /opt/autovibe/.env и впиши реальные значения.
#
# ВАЖНО: на сервере имена БЕЗ префикса VITE_ (в отличие от локального dev,
# где vite-proxy читал VITE_WB_TOKEN / VITE_OZON_*). Здесь работает Node-сервер
# (server.ts → api/route.ts), который читает серверные имена ниже.
# ──────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=8080

# ═══ WILDBERRIES ══════════════════════════════════════════════════════════
# Единый токен со всеми категориями (Контент, Аналитика, Цены, Статистика,
# Продвижение, Отзывы, Поставки). Ради этого и переехали на РФ-сервер —
# WB seller-analytics-api / statistics-api банят зарубежные IP.
WB_TOKEN=

# Опционально — отдельные токены по скоупам (приоритет над WB_TOKEN):
# WB_TOKEN_ANALYTICS=
# WB_TOKEN_STATISTICS=
# WB_TOKEN_CONTENT=
# WB_TOKEN_DISCOUNTS=
# WB_TOKEN_PROMOTION=
# WB_TOKEN_FEEDBACKS=

# ═══ OZON Seller API ══════════════════════════════════════════════════════
OZON_CLIENT_ID=
OZON_API_KEY=

# ═══ OZON Performance API (реклама) ═══════════════════════════════════════
OZON_PERF_CLIENT_ID=
OZON_PERF_CLIENT_SECRET=

# ═══ Anthropic (AI-копилот) ═══════════════════════════════════════════════
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
# Дневной лимит трат на AI в рублях (защита от перерасхода):
AI_DAILY_LIMIT_RUB=500

# ═══ Авторизация дашборда ═════════════════════════════════════════════════
# Если AUTH_PASSWORD пуст — вход открыт (dev). На проде задай оба.
AUTH_PASSWORD=
AUTH_SECRET=

# ═══ Cron secret (защита /api/cron/refresh) ═══════════════════════════════
# Сгенерируй: openssl rand -hex 24
CRON_SECRET=

# ═══ Кэш (опционально) ════════════════════════════════════════════════════
# Не обязательно: Node-процесс долгоживущий, in-memory кэш переживает запросы
# и греется кроном. KV нужен только если захочешь шарить кэш между рестартами.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
