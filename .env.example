# ──────────────────────────────────────────────────────────────────────────
# Auto Vibe — переменные окружения
# ──────────────────────────────────────────────────────────────────────────
# Локалка:  скопируй файл → `.env` и впиши реальные значения.
# Vercel:   Project → Settings → Environment Variables, имена один-в-один.
#           Scope: Production + Preview + Development.
#
# ВАЖНО:
#  - VITE_*  попадают в браузер (для UI-конфига типа Telegram bot id и т.п.)
#  - БЕЗ VITE_  — серверные секреты (токены WB/Ozon, OAuth-секреты, KV ключи).
#    Они НЕ попадают в браузер — используются только в /api/*.
# ──────────────────────────────────────────────────────────────────────────


# ═══ WILDBERRIES — серверные токены ═══════════════════════════════════════
# Кабинет WB → Настройки → Доступ к API → Создать токен.
# Поставь галки на ВСЕ нужные категории:
#   Контент, Аналитика, Цены и скидки, Маркетплейс,
#   Статистика, Продвижение, Отзывы и вопросы, Поставки
WB_TOKEN=

# ── Опционально: отдельные токены по скоупам (имеют приоритет над WB_TOKEN)
# WB_TOKEN_COMMON=
# WB_TOKEN_CONTENT=
# WB_TOKEN_STATISTICS=
# WB_TOKEN_FEEDBACKS=
# WB_TOKEN_DISCOUNTS=
# WB_TOKEN_PROMOTION=
# WB_TOKEN_ANALYTICS=
# WB_TOKEN_SUPPLIES=


# ═══ OZON Seller API ══════════════════════════════════════════════════════
# Используется для: Финансы, Аналитика, Цены, Stocks, Карточки, ROI.
# Кабинет Ozon → Настройки → API → Создать токен (Seller API).
OZON_CLIENT_ID=
OZON_API_KEY=


# ═══ OZON Performance API (Реклама) ═══════════════════════════════════════
# ОТЛИЧАЕТСЯ от Seller API.
# Кабинет рекламы Ozon → API → Создать клиента.
# Client-Id выглядит как NNNNNNNN-NNNNNNNN@advertising.performance.ozon.ru
OZON_PERF_CLIENT_ID=
OZON_PERF_CLIENT_SECRET=


# ═══ Vercel KV (кэш для proxy и OAuth-токенов) ════════════════════════════
# На Vercel: Project → Storage → Create Database → KV
#            (это Upstash Redis под капотом).
# После привязки переменные ставятся автоматически:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Без KV in-memory кэш работает в пределах одного serverless-инстанса.


# ═══ Cron secret (защита /api/cron/refresh от внешних вызовов) ═══════════
# Vercel Cron автоматически отправляет Authorization: Bearer $CRON_SECRET
# на cron-эндпоинты. Сгенерируй случайную строку 32+ символа.
CRON_SECRET=


# ═══ Авторизация (password gate для всего дашборда) ═══════════════════════
# Без этих переменных авторизация ВЫКЛЮЧЕНА (удобно для локалки).
# На проде ОБЯЗАТЕЛЬНО задай AUTH_PASSWORD — иначе сайт публично доступен.
#
# AUTH_PASSWORD — что вводит пользователь в форме логина (login → password)
# AUTH_SECRET   — секрет для подписи session-cookie (HMAC SHA-256).
#                 Сгенерируй случайную строку 32+ символа.
#                 Если не задан — fallback на сам AUTH_PASSWORD (хуже, но работает).
AUTH_PASSWORD=
AUTH_SECRET=


# ═══ Frontend-only (попадают в браузер) ═══════════════════════════════════
# Telegram-бот
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=


# ──────────────────────────────────────────────────────────────────────────
# КЛИЕНТСКИЙ FALLBACK (необязательно)
# ──────────────────────────────────────────────────────────────────────────
# Если хочешь чтобы UI «Настройки → WB-токены» работал без env-токенов
# (например, для демо-сценария «вставь свой токен → проверь подключение»):
#  VITE_WB_TOKEN=     — копия WB_TOKEN, видна в браузере, для прямых вызовов
#                      (НЕ нужна если есть WB_TOKEN на сервере)


# ──────────────────────────────────────────────────────────────────────────
# Деплой на Vercel:
# ──────────────────────────────────────────────────────────────────────────
# 1. git push в репозиторий на github.com (под аккаунтом romanov-d)
# 2. На vercel.com → New Project → Import from GitHub → выбрать репо
# 3. Framework: Vite (определится автоматически)
# 4. Settings → Storage → Create KV Database → Connect
# 5. Settings → Environment Variables → добавь все переменные выше:
#    - WB_TOKEN (универсальный JWT)
#    - OZON_CLIENT_ID, OZON_API_KEY
#    - OZON_PERF_CLIENT_ID, OZON_PERF_CLIENT_SECRET
#    - CRON_SECRET (любая случайная строка)
#    - KV_REST_API_URL, KV_REST_API_TOKEN — добавятся автоматически
# 6. Deploy
#
# Локалка через `vite dev` тоже работает — но без серверного OAuth для
# Ozon Performance. Для полного паритета: `npm i -g vercel && vercel dev`.
# ──────────────────────────────────────────────────────────────────────────
