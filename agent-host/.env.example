# Конфигурация хоста агента. Скопировать в .env и заполнить.
# .env в git не попадает (.gitignore). Перенос на другой ПК = этот файл + профиль Chrome.

AGENT_NAME=home-pc
DASHBOARD_API_URL=https://e-avtovibe.ru
# Тот же ключ, что в AGENT_API_KEY на сервере (/opt/autovibe/.env). Случайная строка >= 32 символов.
AGENT_API_KEY=

# Chrome: отдельный профиль (НЕ личный). В нём один раз вручную войти в
# покупательские аккаунты Ozon и WB. Агент логины/пароли не вводит никогда.
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PROFILE_DIR=C:\agent\chrome-profile
CHROME_DEBUG_PORT=9222

# Как часто опрашивать сервер, сек.
POLL_INTERVAL_SEC=45
