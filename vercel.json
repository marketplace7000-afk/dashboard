{
  "rewrites": [
    { "source": "/api/route",        "destination": "/api/route" },
    { "source": "/api/:path*",       "destination": "/api/route?p=:path*" },
    { "source": "/wb/:path*",        "destination": "/api/route?p=wb/:path*" },
    { "source": "/ozon-perf/:path*", "destination": "/api/route?p=ozon-perf/:path*" },
    { "source": "/ozon/:path*",      "destination": "/api/route?p=ozon/:path*" }
  ],
  "functions": {
    "api/route.ts": {
      "maxDuration": 300
    }
  }
}
